# Copie este arquivo para .env e preencha. O .env nunca vai para o git.

# Banco Neon (Postgres). Painel do Neon > Connection string (use a versão "pooled").
DATABASE_URL="postgresql://usuario:senha@ep-xxxx-pooler.sa-east-1.aws.neon.tech/neondb?sslmode=require"

# Chave secreta do Better Auth: no mínimo 32 caracteres aleatórios.
# Gere uma com:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BETTER_AUTH_SECRET="troque-por-uma-chave-aleatoria-com-32-ou-mais-caracteres"

# URL pública do app. Desenvolvimento: http://localhost:3000 — Produção: https://seu-dominio.com.br
BETTER_AUTH_URL="http://localhost:3000"

# Pasta das fotos (fora de hbuilds/ e public_html/ na Hostinger).
# Desenvolvimento: ./.storage — Produção (exemplo): /home/<usuario>/storage/manutencoes
UPLOAD_DIR="./.storage"

# Usuário técnico (admin) criado por `pnpm db:seed`. Use uma senha forte (8+ caracteres).
SEED_ADMIN_NOME="Nome do Técnico"
SEED_ADMIN_EMAIL="tecnico@exemplo.com.br"
SEED_ADMIN_SENHA="troque-esta-senha"
